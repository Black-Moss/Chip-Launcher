<UserControl x:Class="ChipLauncher.Views.NewsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="15">
        <!-- ── 内容面板（遮罩显示时隐藏） ─────────────────────── -->
        <Grid x:Name="ContentPanel">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- 左侧新闻列表 -->
            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Margin="0,0,10,0">
                <ListBox x:Name="NewsListBox"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="12,10" Margin="0,0,0,4"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="14"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,4"/>
                                    <TextBlock Grid.Row="1"
                                               Text="{Binding PublishDate, StringFormat={}{0:yyyy-MM-dd}}"
                                               FontSize="11"
                                               Foreground="{StaticResource TextSecondaryBrush}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>

            <!-- 右侧详细内容 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="10,0,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="TitleText"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <!-- 打开原文按钮 -->
                    <Button x:Name="OpenUrlButton"
                            Grid.Row="3"
                            Content="🔗 在浏览器中打开原文"
                            Padding="15,8"
                            FontSize="13"
                            HorizontalAlignment="Left"
                            Visibility="Collapsed"
                            Click="OnOpenUrlClick"/>

                    <TextBlock x:Name="DateText"
                               Grid.Row="1"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,15"/>

                    <TextBlock x:Name="ContentText"
                               Grid.Row="2"
                               FontSize="14"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="22"
                               Margin="0,0,0,15"/>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ── 加载中遮罩（显示时自动隐藏内容面板） ──────────── -->
        <Border x:Name="LoadingOverlay"
                Background="#000000"
                Visibility="Collapsed"
                Panel.ZIndex="1">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Background="#333"/>
                <TextBlock Text="正在加载资讯…"
                           FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- ── 加载失败遮罩（显示时自动隐藏内容面板） ────────── -->
        <Border x:Name="ErrorOverlay"
                Background="#000000"
                Visibility="Collapsed"
                Panel.ZIndex="1">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="⚠ 加载失败"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock Text="无法连接到 Steam 资讯服务器，请检查网络后重试"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Opacity="0.7"
                           Margin="0,10,0,20"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap"/>
                <Button Content="🔄 重新加载"
                        Padding="25,10"
                        FontSize="15"
                        HorizontalAlignment="Center"
                        Click="OnRetryClick"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
