<suki:SukiWindow xmlns="https://github.com/avaloniaui"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:suki="clr-namespace:SukiUI.Controls;assembly=SukiUI"
                 xmlns:local="clr-namespace:ChipLauncher.Views"
                 x:Class="ChipLauncher.Views.MainWindow"
                 Title="Chip Launcher"
                 Height="650" Width="900"
                 MinHeight="650" MinWidth="900"
                 WindowStartupLocation="CenterScreen"
                 BackgroundStyle="Flat"
                 TransparencyLevelHint="None"
                 DragDrop.AllowDrop="True"
                 DragDrop.DragEnter="OnWindowDragEnter"
                 DragDrop.DragLeave="OnWindowDragLeave"
                 DragDrop.Drop="OnWindowDrop">

    <!-- SukiUI Toast + Dialog 主机 -->
    <suki:SukiWindow.Hosts>
        <suki:SukiToastHost Name="ToastHost" MaxToasts="5" />
        <suki:SukiDialogHost Name="DialogHost" />
    </suki:SukiWindow.Hosts>

    <!-- 标题栏右侧：启动游戏按钮（SukiUI Flat 样式，始终可见） -->
    <suki:SukiWindow.RightWindowTitleBarControls>
        <StackPanel Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Spacing="12">
            <!-- 游戏信息文本 -->
            <ItemsControl Name="GameInfoPanel"
                          VerticalAlignment="Center"
                          IsVisible="False">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   FontSize="12"
                                   Foreground="#888888"
                                   Margin="4,0" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <!-- BepInEx 警告（点击打开安装对话框） -->
            <Border Name="BepInExWarning"
                    Classes="Flat Accent"
                    VerticalAlignment="Center"
                    Background="#3d1a00"
                    CornerRadius="4"
                    Padding="8,3"
                    Cursor="Hand"
                    IsVisible="False"
                    PointerPressed="OnBepInExWarningClick">
                <TextBlock Text="⚠ BepInEx 未安装"
                           FontSize="11"
                           Foreground="#e67e22" />
            </Border>
            <Button Classes="Flat"
                    Content="启动游戏"
                    FontSize="11"
                    Padding="8,3"
                    x:Name="BtnPlayCompact" />
        </StackPanel>
    </suki:SukiWindow.RightWindowTitleBarControls>

    <!-- 主内容区 -->
    <Grid Background="#FF1a1a1a">
        <!-- SukiSideMenu — 导航栏 + 内容区 -->
        <suki:SukiSideMenu>
            <suki:SukiSideMenu.Items>
                <suki:SukiSideMenuItem Header="模组管理"
                                       Classes="Compact"
                                       x:Name="SideMenuMods"
                                       Foreground="#999999">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Text="📦" FontSize="20" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <local:ModsPage />
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="游戏资讯"
                                       Classes="Compact"
                                       x:Name="SideMenuNews"
                                       Foreground="#999999">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Text="📰" FontSize="20" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <local:NewsPage />
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="设置"
                                       Classes="Compact"
                                       x:Name="SideMenuSettings"
                                       Foreground="#999999">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Text="⚙" FontSize="20" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <local:SettingsPage />
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>

                <suki:SukiSideMenuItem Header="关于"
                                       Classes="Compact"
                                       x:Name="SideMenuAbout"
                                       Foreground="#999999">
                    <suki:SukiSideMenuItem.Icon>
                        <TextBlock Text="ℹ" FontSize="20" />
                    </suki:SukiSideMenuItem.Icon>
                    <suki:SukiSideMenuItem.PageContent>
                        <local:AboutPage />
                    </suki:SukiSideMenuItem.PageContent>
                </suki:SukiSideMenuItem>
            </suki:SukiSideMenu.Items>
        </suki:SukiSideMenu>

        <!-- ══════ 窗口级拖放遮罩 ══════ -->
        <Border Name="WindowDropOverlay"
                Background="#aa000000"
                IsVisible="False"
                IsHitTestVisible="False"
                ZIndex="200">
            <Border BorderBrush="#e67e22"
                    BorderThickness="2"
                    CornerRadius="8"
                    Background="#1a1a1a"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="50,35">
                <StackPanel Spacing="12" HorizontalAlignment="Center">
                    <TextBlock Name="WindowDropOverlayTitle"
                               FontSize="22"
                               Foreground="#e67e22"
                               HorizontalAlignment="Center" />
                    <TextBlock Name="WindowDropFileName"
                               FontSize="14"
                               Foreground="#aaa"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</suki:SukiWindow>