<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ChipLauncher.Views.MainWindow"
        Title="Chip Launcher"
        Height="550" Width="800"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        Background="#000000">

    <!-- 外层 Border：ClipToBounds 让圆角裁剪内容 -->
    <Border CornerRadius="10"
            Background="#000000"
            ClipToBounds="True">

        <Grid RowDefinitions="90,*" ColumnDefinitions="160,*">

            <!-- 顶部标题栏（拖拽区域） -->
            <Border Name="TitleBar"
                    Grid.Row="0" Grid.ColumnSpan="2"
                    Background="#000000">
                <Grid Margin="20,0,10,0" ColumnDefinitions="Auto,*,Auto">

                    <TextBlock Text="Chip Launcher"
                               FontSize="22"
                               FontWeight="Bold"
                               Foreground="White"
                               VerticalAlignment="Center" />

                    <!-- 游戏信息（灰色小字，紧挨标题右侧） -->
                    <ItemsControl Name="GameInfoPanel"
                                  Grid.Column="1"
                                  Margin="12,0,0,0"
                                  VerticalAlignment="Center"
                                  IsVisible="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}"
                                           FontSize="12"
                                           Foreground="#888888"
                                           Margin="4,0" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- 窗口控制按钮 -->
                    <StackPanel Grid.Column="2"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <Button Name="BtnMinimize"
                                Content="─"
                                Width="30" Height="30"
                                FontSize="16"
                                ToolTip.Tip="最小化"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Name="BtnMaximize"
                                Content="▢"
                                Width="30" Height="30"
                                FontSize="16"
                                Margin="4,0"
                                ToolTip.Tip="最大化"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                        <Button Name="BtnClose"
                                Content="╳"
                                Width="30" Height="30"
                                FontSize="16"
                                ToolTip.Tip="关闭"
                                Background="Transparent"
                                Foreground="White"
                                BorderThickness="0"
                                Cursor="Hand" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 左侧导航栏 -->
            <Border Grid.Row="1" Grid.Column="0"
                    Background="#000000">
                <StackPanel HorizontalAlignment="Stretch">
                    <Button Name="BtnPlay"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            FontSize="15"
                            Padding="10,12"
                            Margin="0,2"
                            Cursor="Hand"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch">
                        <TextBlock Text="⏬ 启动游戏"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Stretch" />
                    </Button>
                    <Button Name="BtnMods"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            FontSize="15"
                            Padding="10,12"
                            Margin="0,2"
                            Cursor="Hand"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch">
                        <TextBlock Text="📦 模组管理"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Stretch" />
                    </Button>
                    <Button Name="BtnNews"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            FontSize="15"
                            Padding="10,12"
                            Margin="0,2"
                            Cursor="Hand"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch">
                        <TextBlock Text="📰 游戏资讯"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Stretch" />
                    </Button>
                    <Button Name="BtnSettings"
                            Background="Transparent"
                            Foreground="#CCCCCC"
                            FontSize="15"
                            Padding="10,12"
                            Margin="0,2"
                            Cursor="Hand"
                            BorderThickness="0"
                            HorizontalContentAlignment="Stretch">
                        <TextBlock Text="⚙ 设置"
                                   TextAlignment="Center"
                                   HorizontalAlignment="Stretch" />
                    </Button>
                </StackPanel>
            </Border>

            <!-- 右侧内容区 -->
            <ContentControl Name="ContentFrame"
                            Grid.Row="1" Grid.Column="1"
                            Background="#000000" />
        </Grid>
    </Border>
</Window>
