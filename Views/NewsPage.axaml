<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="ChipLauncher.Views.NewsPage">
    <Grid Margin="15">
        <!-- ── 内容面板（遮罩显示时隐藏） ─────────────────────── -->
        <Grid Name="ContentPanel" IsVisible="True" ColumnDefinitions="300,*">

            <!-- 左侧新闻列表 -->
            <Border BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="0,0,1,0"
                    Margin="0,0,10,0">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- 标题 + 刷新按钮 -->
                    <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,6">
                        <TextBlock Text="游戏资讯"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" />
                        <Button x:Name="RefreshButton"
                                Grid.Column="1"
                                Content="🔄 刷新"
                                Padding="12,5"
                                FontSize="13"
                                Cursor="Hand" />
                    </Grid>
                    <!-- 搜索框 -->
                    <TextBox Name="NewsSearchBox"
                             Grid.Row="1"
                             Watermark="搜索资讯…"
                             FontSize="13"
                             Padding="8,5"
                             Margin="0,0,0,6"
                             Background="#1a1a1a"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             BorderBrush="{StaticResource BorderBrush}"
                             BorderThickness="1"
                             />
                    <ListBox Name="NewsListBox"
                             Grid.Row="2"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Background" Value="Transparent" />
                            </Style>
                            <Style Selector="ListBoxItem:selected">
                                <Setter Property="Background" Value="#555555" />
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="#555555" />
                            </Style>
                            <Style Selector="ListBoxItem:focus /template/ ContentPresenter">
                                <Setter Property="Background" Value="#555555" />
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="12,10" Margin="0,0,0,4"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid RowDefinitions="Auto,Auto">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="14"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,0,0,4" />
                                        <TextBlock Grid.Row="1"
                                                   Text="{Binding PublishDate, StringFormat={}{0:yyyy-MM-dd}}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- 右侧详细内容 -->
            <ScrollViewer Grid.Column="1"
                          VerticalScrollBarVisibility="Auto">
                <Grid Margin="10,0,0,0" RowDefinitions="Auto,Auto,Auto,*">

                    <SelectableTextBlock Name="TitleText"
                               FontSize="18"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,6"
                               SelectionBrush="#555555"
                               SelectionForegroundBrush="White" />

                    <SelectableTextBlock Name="DateText"
                               Grid.Row="1"
                               FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"
                               Margin="0,0,0,6"
                               SelectionBrush="#555555"
                               SelectionForegroundBrush="White" />

                    <!-- 打开原文按钮（日期下方） -->
                    <Button Name="OpenUrlButton"
                            Grid.Row="2"
                            Content="🔗 在浏览器中打开原文"
                            Padding="15,8"
                            FontSize="13"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,12"
                            IsVisible="False" />

                    <SelectableTextBlock Name="ContentText"
                                         Grid.Row="3"
                                         FontSize="14"
                                         Foreground="{StaticResource TextSecondaryBrush}"
                                         TextWrapping="Wrap"
                                         SelectionBrush="#555555"
                                         SelectionForegroundBrush="White" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ── 加载中遮罩（显示时自动隐藏内容面板） ──────────── -->
        <Border Name="LoadingOverlay"
                Background="#000000"
                IsVisible="False"
                ZIndex="1">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="200"
                             Height="4"
                             Foreground="{StaticResource TextPrimaryBrush}"
                             Background="#333" />
                <TextBlock Text="正在加载资讯…"
                           FontSize="16"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           Margin="0,15,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- ── 加载失败遮罩（显示时自动隐藏内容面板） ────────── -->
        <Border Name="ErrorOverlay"
                Background="#000000"
                IsVisible="False"
                ZIndex="1">
            <StackPanel VerticalAlignment="Center"
                        HorizontalAlignment="Center">
                <TextBlock Text="⚠ 加载失败"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="{StaticResource TextPrimaryBrush}"
                           HorizontalAlignment="Center" />
                <TextBlock Text="无法连接到 Steam 资讯服务器，请检查网络后重试"
                           FontSize="14"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           Opacity="0.7"
                           Margin="0,10,0,20"
                           HorizontalAlignment="Center"
                           TextWrapping="Wrap" />
                <Button Name="RetryButton"
                        Content="🔄 重新加载"
                        Padding="25,10"
                        FontSize="15"
                        HorizontalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>