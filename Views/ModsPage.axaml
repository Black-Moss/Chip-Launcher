<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChipLauncher.Views"
             x:Class="ChipLauncher.Views.ModsPage">
    <Grid Margin="15" ColumnDefinitions="300,5,*">

        <!-- ══════ 左侧：模组列表 ══════ -->
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,*">

            <TextBlock Text="模组管理"
                       Classes="PageTitle" />

            <!-- 搜索框 -->
            <TextBox Name="ModSearchBox"
                     Grid.Row="1"
                     Watermark="搜索模组…"
                     FontSize="13"
                     Padding="8,5"
                     Margin="0,0,0,6"
                     Background="#1a1a1a"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     KeyDown="OnModSearchKeyDown" />

            <!-- 工具按钮行：安装 + 排序 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,0,0,6" HorizontalAlignment="Center">
                <Button Classes="Flat" Name="BtnInstallLocal"
                        Content="安装本地模组"
                        Padding="10,5"
                        FontSize="11"
                        Click="OnInstallLocalClick" />
                <Button Classes="Flat" Name="BtnOpenModFolder"
                        Content="模组文件夹"
                        Padding="10,5"
                        FontSize="11"
                        Click="OnOpenModFolderClick" />
                <Button Classes="Flat" Name="BtnOpenConfigFolder"
                        Content="配置文件夹"
                        Padding="10,5"
                        FontSize="11"
                        Click="OnOpenConfigFolderClick" />
                <Button Classes="Flat" Name="BtnSortOrder"
                        Content="A-Z ▾"
                        Padding="8,5"
                        FontSize="11"
                        Click="OnSortOrderClick" />
            </StackPanel>

            <!-- 模组统计 + 批量操作工具栏 -->
            <StackPanel Grid.Row="3" Margin="0,0,0,6" Spacing="4">
                <TextBlock Name="ModStatsText"
                           FontSize="12"
                           Foreground="#888" />
                <StackPanel Name="BatchToolbar"
                            Orientation="Horizontal"
                            Spacing="6"
                            IsVisible="False">
                    <Button Classes="Flat" Name="BtnBatchSelectAll"
                            Content="全选"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnBatchSelectAllClick" />
                    <Button Classes="Flat" Name="BtnBatchEnable"
                            Content="启用选中"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnBatchEnableClick" />
                    <Button Classes="Flat" Name="BtnBatchDisable"
                            Content="禁用选中"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnBatchDisableClick" />
                    <Button Classes="Flat" Name="BtnBatchDelete"
                            Content="删除选中"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnBatchDeleteClick" />
                    <Button Classes="Flat" Name="BtnBatchInvert"
                            Content="反选"
                            Padding="8,4"
                            FontSize="11"
                            Click="OnBatchInvertClick" />
                </StackPanel>
            </StackPanel>

            <ListBox Name="ModListBox"
                     Grid.Row="4"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionChanged="OnModSelected"
                     PointerPressed="OnModListPointerPressed">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="6,8"
                                Margin="0,0,0,3"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto">

                                <!-- 选择复选框（双向绑定到 ModInfo.IsChecked） -->
                                <CheckBox Tag="{Binding}"
                                          IsChecked="{Binding IsChecked}"
                                          IsHitTestVisible="True"
                                          VerticalAlignment="Center"
                                          Margin="0,0,4,0"
                                          Click="OnModCheckBoxClick" />

                                <!-- 状态圆点 -->
                                <Ellipse Grid.Column="1" Width="8" Height="8"
                                         Fill="{Binding IsEnabled, Converter={x:Static local:ModsPage.ColorConverter}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />

                                <!-- 模组名 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- 状态文本 -->
                                <TextBlock Grid.Column="3"
                                           Text="{Binding IsEnabled, Converter={x:Static local:ModsPage.StatusTextConverter}}"
                                           FontSize="11"
                                           Foreground="#888"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <!-- 切换按钮（背景色随状态变化） -->
                                <Button Classes="Flat"
                                        Grid.Column="4"
                                        Content="{Binding IsEnabled, Converter={x:Static local:ModsPage.ToggleTextConverter}}"
                                        Background="{Binding IsEnabled, Converter={x:Static local:ModsPage.ToggleColorConverter}}"
                                        Padding="8,4"
                                        FontSize="11"
                                        MinWidth="48"
                                        Tag="{Binding}"
                                        Click="OnToggleClick"
                                        HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="EmptyHint"
                       Grid.Row="4"
                       Text="未找到 BepInEx 模组&#x0a;请确保模组位于 BepInEx\plugins 目录"
                       FontSize="13"
                       Foreground="#888"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <TextBlock Name="ErrorHint"
                       Grid.Row="4"
                       Text=""
                       FontSize="13"
                       Foreground="#e74c3c"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
        </Grid>

        <!-- ══════ 分隔线 ══════ -->
        <Border Grid.Column="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Margin="0,0,0,0" />

        <!-- ══════ 右侧：配置编辑器 ══════ -->
        <Grid Grid.Column="2"
              Margin="10,0,0,0"
              RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
              IsVisible="False"
              Name="ConfigPanel">

            <!-- 模组名（始终显示） -->
            <TextBlock Name="ConfigModName"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4" />

            <!-- 配置文件名（有配置才显示） -->
            <TextBlock Name="ConfigFileName"
                       Grid.Row="1"
                       FontSize="12"
                       Foreground="#888"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       IsVisible="False" />

            <!-- 配置不可用时的提示 -->
            <TextBlock Name="ConfigDescription"
                       Grid.Row="1"
                       FontSize="12"
                       Foreground="#888"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12"
                       IsVisible="False" />

            <!-- 操作按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Classes="Flat" Name="BtnDeleteMod"
                        Content="删除模组"
                        Padding="15,8"
                        FontSize="13"
                        Click="OnDeleteClick" />
                <Button Classes="Flat" Name="BtnSaveConfig"
                        Content="保存配置"
                        Padding="15,8"
                        FontSize="13"
                        Click="OnSaveConfigClick" />
                <Button Classes="Flat" Name="BtnResetConfig"
                        Content="重置配置"
                        Padding="15,8"
                        FontSize="13"
                        Click="OnResetConfigClick" />
                <Button Classes="Flat" Name="BtnOpenConfig"
                        Content="打开配置"
                        Padding="15,8"
                        FontSize="13"
                        Click="OnOpenConfigClick" />
            </StackPanel>

            <!-- 删除确认面板 -->
            <Border Name="DeleteConfirmPanel"
                    Grid.Row="3"
                    BorderBrush="#e74c3c"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="#1a0000"
                    Padding="15,12"
                    Margin="0,0,0,8"
                    IsVisible="False"
                    VerticalAlignment="Top">
                <StackPanel Spacing="10">
                    <TextBlock Name="DeleteConfirmText"
                               FontSize="14"
                               Foreground="#e74c3c"
                               TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Classes="Flat" Name="BtnConfirmDelete"
                                Content="✔ 确认删除"
                                Padding="15,8"
                                FontSize="13"
                                Click="OnConfirmDeleteClick" />
                        <Button Classes="Flat" Name="BtnCancelDelete"
                                Content="✖ 取消"
                                Padding="15,8"
                                FontSize="13"
                                Click="OnCancelDeleteClick" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="5"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="ConfigItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8"
                                    Margin="0,0,0,8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid RowDefinitions="Auto,Auto,Auto">

                                    <!-- 描述 -->
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="#aaa"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,2" />

                                    <!-- 键名 + 类型 -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Key}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding SettingType, StringFormat='({0})'}"
                                                   FontSize="11"
                                                   Foreground="#888" />
                                        <TextBlock Text="{Binding DefaultValue, StringFormat='默认: {0}'}"
                                                   FontSize="11"
                                                   Foreground="#666" />
                                    </StackPanel>

                                    <!-- 布尔值使用开关 -->
                                    <ToggleSwitch Grid.Row="2"
                                                  IsChecked="{Binding Value, Converter={x:Static local:ModsPage.StringToBoolConverter}, Mode=TwoWay}"
                                                  OnContent="开启"
                                                  OffContent="关闭"
                                                  IsVisible="{Binding SettingType, Converter={x:Static local:ModsPage.IsBooleanConverter}}" />

                                    <!-- 非布尔值使用文本输入框 -->
                                    <TextBox Grid.Row="2"
                                             Text="{Binding Value, Mode=TwoWay}"
                                             FontSize="13"
                                             Padding="6,4"
                                             AcceptsReturn="False"
                                             IsVisible="{Binding SettingType, Converter={x:Static local:ModsPage.IsNotBooleanConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 未选择模组时的提示 -->
        <TextBlock Name="NoSelectionHint"
                   Grid.Column="2"
                   Text="选择一个模组查看和编辑配置"
                   FontSize="14"
                   Foreground="#888"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   IsVisible="True" />

        <!-- ══════ 安装中加载遮罩 ══════ -->
        <Border Name="InstallOverlay"
                Grid.ColumnSpan="3"
                Background="#88000000"
                IsVisible="False"
                ZIndex="100">
            <Border Background="#2a2a2a"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="40,30"
                    Width="280"
                    Height="120"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center">
                <StackPanel Spacing="16" VerticalAlignment="Center">
                    <ProgressBar IsIndeterminate="True"
                                 Height="6"
                                 Foreground="#e67e22"
                                 Background="#444"
                                 BorderThickness="0" />
                    <TextBlock Text="正在安装模组…"
                               FontSize="15"
                               Foreground="#cccccc"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>