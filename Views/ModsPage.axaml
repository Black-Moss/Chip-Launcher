<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:ChipLauncher.Views"
             x:Class="ChipLauncher.Views.ModsPage">
    <Grid Margin="15" ColumnDefinitions="300,5,*">

        <!-- ══════ 左侧：模组列表 ══════ -->
        <Grid RowDefinitions="Auto,Auto,Auto,*">

            <TextBlock Text="模组管理"
                       Classes="PageTitle" />

            <!-- 搜索框 -->
            <TextBox Name="ModSearchBox"
                     Grid.Row="1"
                     Watermark="搜索模组…"
                     FontSize="13"
                     Padding="8,5"
                     Margin="0,0,0,6"
                     Background="#1a1a1a"
                     Foreground="{StaticResource TextPrimaryBrush}"
                     BorderBrush="{StaticResource BorderBrush}"
                     BorderThickness="1"
                     KeyDown="OnModSearchKeyDown" />

            <ListBox Name="ModListBox"
                     Grid.Row="2"
                     Background="Transparent"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     SelectionChanged="OnModSelected">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Padding="10,8"
                                Margin="0,0,0,3"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">

                                <!-- 状态圆点 -->
                                <Ellipse Width="8" Height="8"
                                         Fill="{Binding IsEnabled, Converter={x:Static local:ModsPage.ColorConverter}}"
                                         VerticalAlignment="Center"
                                         Margin="0,0,8,0" />

                                <!-- 模组名 -->
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="14"
                                           Foreground="{StaticResource TextPrimaryBrush}"
                                           VerticalAlignment="Center"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- 状态文本 -->
                                <TextBlock Grid.Column="2"
                                           Text="{Binding IsEnabled, Converter={x:Static local:ModsPage.StatusTextConverter}}"
                                           FontSize="11"
                                           Foreground="#888"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0" />

                                <!-- 切换按钮 -->
                                <Button Grid.Column="3"
                                        Content="{Binding IsEnabled, Converter={x:Static local:ModsPage.ToggleTextConverter}}"
                                        Padding="8,4"
                                        FontSize="11"
                                        MinWidth="48"
                                        Cursor="Hand"
                                        Tag="{Binding}"
                                        Click="OnToggleClick"
                                        HorizontalAlignment="Right" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Name="EmptyHint"
                       Grid.Row="3"
                       Text="未找到 BepInEx 模组&#x0a;请确保游戏已安装 BepInEx&#x0a;且模组位于 BepInEx\plugins 目录"
                       FontSize="13"
                       Foreground="#888"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />

            <TextBlock Name="ErrorHint"
                       Grid.Row="3"
                       Text=""
                       FontSize="13"
                       Foreground="#e74c3c"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap"
                       IsVisible="False" />
        </Grid>

        <!-- ══════ 分隔线 ══════ -->
        <Border Grid.Column="1"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,1,0"
                Margin="0,0,0,0" />

        <!-- ══════ 右侧：配置编辑器 ══════ -->
        <Grid Grid.Column="2"
              Margin="10,0,0,0"
              RowDefinitions="Auto,Auto,Auto,*"
              IsVisible="False"
              Name="ConfigPanel">

            <TextBlock Name="ConfigFileName"
                       FontSize="16"
                       FontWeight="Bold"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       Margin="0,0,0,4" />

            <TextBlock Name="ConfigDescription"
                       Grid.Row="1"
                       FontSize="12"
                       Foreground="#888"
                       TextWrapping="Wrap"
                       Margin="0,0,0,12" />

            <!-- 保存按钮 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10" Margin="0,0,0,10">
                <Button Name="BtnSaveConfig"
                        Content="💾 保存配置"
                        Padding="15,8"
                        FontSize="13"
                        Cursor="Hand"
                        Click="OnSaveConfigClick" />
                <TextBlock Name="SaveStatus"
                           FontSize="12"
                           Foreground="#4CAF50"
                           VerticalAlignment="Center"
                           IsVisible="False" />
            </StackPanel>

            <ScrollViewer Grid.Row="3"
                          VerticalScrollBarVisibility="Auto">
                <ItemsControl Name="ConfigItemsControl">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="10,8"
                                    Margin="0,0,0,8"
                                    BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="0,0,0,1">
                                <Grid RowDefinitions="Auto,Auto,Auto">

                                    <!-- 描述 -->
                                    <TextBlock Text="{Binding Description}"
                                               FontSize="12"
                                               Foreground="#aaa"
                                               TextWrapping="Wrap"
                                               Margin="0,0,0,2" />

                                    <!-- 键名 + 类型 -->
                                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
                                        <TextBlock Text="{Binding Key}"
                                                   FontSize="13"
                                                   FontWeight="Bold"
                                                   Foreground="{StaticResource TextPrimaryBrush}" />
                                        <TextBlock Text="{Binding SettingType, StringFormat='({0})'}"
                                                   FontSize="11"
                                                   Foreground="#888" />
                                        <TextBlock Text="{Binding DefaultValue, StringFormat='默认: {0}'}"
                                                   FontSize="11"
                                                   Foreground="#666" />
                                    </StackPanel>

                                    <!-- 布尔值使用开关 -->
                                    <ToggleSwitch Grid.Row="2"
                                                  IsChecked="{Binding Value, Converter={x:Static local:ModsPage.StringToBoolConverter}, Mode=TwoWay}"
                                                  OnContent="开启"
                                                  OffContent="关闭"
                                                  IsVisible="{Binding SettingType, Converter={x:Static local:ModsPage.IsBooleanConverter}}" />

                                    <!-- 非布尔值使用文本输入框 -->
                                    <TextBox Grid.Row="2"
                                             Text="{Binding Value, Mode=TwoWay}"
                                             FontSize="13"
                                             Padding="6,4"
                                             AcceptsReturn="False"
                                             IsVisible="{Binding SettingType, Converter={x:Static local:ModsPage.IsNotBooleanConverter}}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- 未选择模组时的提示 -->
        <TextBlock Name="NoSelectionHint"
                   Grid.Column="2"
                   Text="选择一个模组查看和编辑配置"
                   FontSize="14"
                   Foreground="#888"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   IsVisible="True" />

    </Grid>
</UserControl>
