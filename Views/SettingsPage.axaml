<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:ChipLauncher.Services"
             x:Class="ChipLauncher.Views.SettingsPage">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition />
        </Grid.RowDefinitions>

        <TextBlock Text="设置"
                   Classes="PageTitle"/>

        <!-- 游戏路径 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="游戏路径："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     FontSize="14"
                     Padding="5"
                     Margin="0,0,5,0"
                     Text="{Binding GamePath, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}"/>
            <Button Grid.Column="2"
                    Content="浏览…"
                    Padding="10,5"
                    Click="OnBrowseClick"/>
        </Grid>

        <!-- 资讯重试次数 -->
        <Grid Grid.Row="2" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="重试次数："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     FontSize="14"
                     Padding="5"
                     Text="{Binding MaxRetries, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2"
                       Text="(资讯加载失败时的重试次数)"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </Grid>

        <!-- 文本轮播间隔 -->
        <Grid Grid.Row="3" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="轮播间隔："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center"/>
            <TextBox Grid.Column="1"
                     FontSize="14"
                     Padding="5"
                     Text="{Binding TextRotationInterval, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}"/>
            <TextBlock Grid.Column="2"
                       Text="(标题游戏文本切换间隔，单位：秒)"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0"/>
        </Grid>

        <!-- 提示 -->
        <TextBlock Grid.Row="4"
                   Text="设置修改后自动保存"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="13"
                   Opacity="0.6"
                   VerticalAlignment="Top"
                   Margin="0,5,0,0"/>
    </Grid>
</UserControl>
