<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:services="using:ChipLauncher.Services"
             x:Class="ChipLauncher.Views.SettingsPage">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="设置"
                   Classes="PageTitle" />

        <!-- 搜索框 -->
        <TextBox Name="SettingsSearchBox"
                 Grid.Row="1"
                 Watermark="搜索设置…"
                 FontSize="13"
                 Padding="8,5"
                 Margin="0,0,0,8" />

        <!-- 游戏路径 -->
        <Grid Grid.Row="2" Margin="0,0,0,12" ColumnDefinitions="100,*,Auto"
              Name="SettingsGamePathRow">
            <TextBlock Text="游戏路径："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     FontSize="14"
                     Padding="5"
                     Margin="0,0,5,0"
                     Text="{Binding GamePath, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}" />
            <Button Classes="Flat"
                    Grid.Column="2"
                    Content="浏览…"
                    Padding="10,5"
                    Click="OnBrowseClick" />
        </Grid>

        <!-- 资讯重试次数 -->
        <Grid Grid.Row="3" Margin="0,0,0,12" ColumnDefinitions="100,80,*"
              Name="SettingsRetryRow">
            <TextBlock Text="重试次数："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     FontSize="14"
                     Padding="5"
                     Text="{Binding MaxRetriesText, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}" />
            <TextBlock Grid.Column="2"
                       Text="(资讯加载失败时的重试次数，范围 1~20)"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </Grid>

        <!-- 文本轮播间隔 -->
        <Grid Grid.Row="4" Margin="0,0,0,12" ColumnDefinitions="100,80,*"
              Name="SettingsRotationRow">
            <TextBlock Text="轮播间隔："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <TextBox Grid.Column="1"
                     FontSize="14"
                     Padding="5"
                     Text="{Binding TextRotationIntervalText, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}" />
            <TextBlock Grid.Column="2"
                       Text="(标题游戏文本切换间隔，范围 1~60 秒)"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </Grid>

        <!-- 默认启动页面 -->
        <Grid Grid.Row="5" Margin="0,0,0,12" ColumnDefinitions="100,160,*"
              Name="SettingsStartupRow">
            <TextBlock Text="启动页面："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <ComboBox Name="StartupPageCombo"
                      Grid.Column="1"
                      SelectedIndex="{Binding DefaultPageIndex, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}"
                      FontSize="14"
                      Padding="5,4">
                <ComboBoxItem Content="📰 游戏资讯" />
                <ComboBoxItem Content="📦 模组管理" />
                <ComboBoxItem Content="⚙ 设置" />
                <ComboBoxItem Content="ℹ 关于" />
            </ComboBox>
            <TextBlock Grid.Column="2"
                       Text="启动时默认显示的页面"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </Grid>

        <!-- 删除模组确认 -->
        <Grid Grid.Row="7" Margin="0,0,0,12" ColumnDefinitions="100,120,*"
              Name="SettingsDeleteConfirmRow">
            <TextBlock Text="删除确认："
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="14"
                       VerticalAlignment="Center" />
            <ToggleSwitch Grid.Column="1"
                          IsChecked="{Binding ConfirmModDeletion, Source={x:Static services:AppConfig.Instance}, Mode=TwoWay}"
                          OnContent="开启"
                          OffContent="关闭" />
            <TextBlock Grid.Column="2"
                       Text="删除模组前显示二次确认对话框"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Opacity="0.5"
                       VerticalAlignment="Center"
                       Margin="8,0,0,0" />
        </Grid>

        <!-- 清除缓存 -->
        <StackPanel Grid.Row="9" Orientation="Horizontal" Spacing="15" Margin="0,10,0,0"
                    Name="SettingsCacheRow">
            <Button Classes="Flat"
                    Name="BtnClearCache"
                    Content="🗑 清除资讯缓存"
                    Padding="15,8"
                    FontSize="13"
                    Click="OnClearCacheClick" />
            <TextBlock Text="删除本地缓存的 Steam 资讯文件，下次打开资讯页时将重新拉取"
                       Foreground="{StaticResource TextSecondaryBrush}"
                       FontSize="12"
                       Opacity="0.6"
                       VerticalAlignment="Center" />
        </StackPanel>

        <!-- 提示 -->
        <TextBlock Grid.Row="10"
                   Text="设置修改后自动保存"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   FontSize="13"
                   Opacity="0.6"
                   VerticalAlignment="Top"
                   Margin="0,5,0,0" />
    </Grid>
</UserControl>